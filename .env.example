# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# Generate secrets with: just generate-secret

# Read by the examples (jwt_standalone, oauth_axum). Use >= 32 random bytes each.
JWT_SECRET="change-me"
JWT_ELEVATED_SECRET="change-me-too"

# Only needed for the Postgres/Redis-backed stores and the API tests' tooling.
POSTGRES_PASSWORD="password"
DATABASE_URL="postgres://postgres:password@localhost:5432"
REDIS_HOST_NAME="127.0.0.1"

# Build sqlx queries from the checked-in `.sqlx/` data instead of a live database.
SQLX_OFFLINE="true"

# Only needed when using PostmarkEmailClient.
POSTMARK_AUTH_TOKEN="your-postmark-server-token"
